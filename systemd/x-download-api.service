[Unit]
Description=x-download
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/x-download
Environment=PYTHONPATH=/opt/x-download
Environment=XDOWNLOAD_HOST=127.0.0.1
Environment=XDOWNLOAD_PORT=18111
ExecStart=/opt/x-download/.venv/bin/python -m uvicorn backend.server:app --host 127.0.0.1 --port 18111
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
